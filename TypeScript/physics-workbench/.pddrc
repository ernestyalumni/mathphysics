version: "1.0"
contexts:
  model_typescript:
    paths: ["prompts/model_typescript.prompt", "src/model.ts"]
    defaults:
      prompts_dir: prompts
      generate_output_path: src/model.ts
      test_output_path: tests/
      default_language: typescript
  api_typescript:
    paths: ["prompts/api_typescript.prompt", "src/api.ts"]
    defaults:
